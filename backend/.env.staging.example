PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-local-dev-secret
FRONTEND_URL=https://lipa-frontend-staging.onrender.com
PICTURES_DIR=./data/pictures

# Usar SOLO la External Database URL de Render para lipa-db-staging.
# No usar lipa-db-prod ni URLs antiguas/no identificadas.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME

OPENAI_API_KEY=
OPENAI_REGLAMENTO_MODEL=gpt-4.1-mini
